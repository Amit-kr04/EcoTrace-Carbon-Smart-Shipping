PORT=5050
CLIENT_URL=http://localhost:5173

# Leave empty to run a local MongoDB automatically (data kept in server/.data).
# For MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/ecotrace
MONGO_URI=

JWT_SECRET=change-me-to-a-long-random-string

# Python ML service (FastAPI). Must match ML_API_KEY in ml/.env
ML_URL=http://127.0.0.1:8000
ML_API_KEY=dev-ml-key

# OpenRouteService (free key at https://openrouteservice.org). Optional:
# without a key EcoTrace uses straight-line distance x 1.25 road factor.
ORS_API_KEY=

# SMTP for alert/report emails. Optional: without it emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoTrace <alerts@ecotrace.local>

# Seed a demo company (owner@ecotrace.demo / demo1234) when the database is empty
SEED_DEMO=true
